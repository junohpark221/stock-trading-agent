# =============================================================================
# Stock Trading Agent - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Phase 0: Core Infrastructure
# -----------------------------------------------------------------------------
ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trading_agent
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=DEBUG

# -----------------------------------------------------------------------------
# Phase 1: KIS Broker (한국투자증권 API)
# -----------------------------------------------------------------------------
# KIS_APP_KEY=
# KIS_APP_SECRET=
# KIS_ACCOUNT_NO=
# KIS_ACCOUNT_PROD=01
# KIS_IS_PAPER=true
# KIS_HTS_ID=

# Phase 1: KIS Optional Settings (defaults in src/config.py)
# KIS_BASE_URL=                    # 빈 값이면 KIS_IS_PAPER로 자동 결정
# KIS_RATE_LIMIT_INTERVAL=0.5     # API 호출 간격 (초). paper=0.5, prod=0.05
# KIS_TOKEN_REDIS_TTL=82800       # OAuth 토큰 Redis TTL (초). 기본 23시간
# KIS_OHLCV_CACHE_TTL=300         # 일봉 캐시 TTL (초). 기본 5분
# KIS_PRICE_CACHE_TTL=10          # 현재가 캐시 TTL (초). 기본 10초

# -----------------------------------------------------------------------------
# Phase 2: Market Data
# -----------------------------------------------------------------------------
# MARKET_DATA_CACHE_TTL=60
# MARKET_OPEN_TIME=09:00
# MARKET_CLOSE_TIME=15:30

# -----------------------------------------------------------------------------
# Phase 2: External Data Sources
# -----------------------------------------------------------------------------
# DART (전자공시시스템)
# DART_API_KEY=your_dart_api_key_here

# 한국은행 ECOS
# ECOS_API_KEY=your_ecos_api_key_here

# FRED (US Federal Reserve)
# FRED_API_KEY=your_fred_api_key_here

# 네이버 검색 API (뉴스 + DataLab)
# NAVER_CLIENT_ID=your_naver_client_id_here
# NAVER_CLIENT_SECRET=your_naver_client_secret_here

# Cache TTL (seconds, optional - defaults in config.py)
# DART_CACHE_TTL=86400
# ECOS_CACHE_TTL=86400
# FRED_CACHE_TTL=86400
# NEWS_CACHE_TTL=3600

# -----------------------------------------------------------------------------
# Phase 3: LLM Providers
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# LLM_MONTHLY_BUDGET_USD=100.00
# LLM_DEFAULT_PROVIDER=google

# Phase 3: LLM 세부 설정 (기본값은 config.py 참조)
# LLM_ESCALATION_CONFIDENCE_THRESHOLD=0.60
# LLM_RESPONSE_CACHE_TTL=1800
# LLM_CONFIG_CACHE_TTL=300
# LLM_BUDGET_WARNING_PCT=80
# LLM_MAX_RETRIES=3
# LLM_REQUEST_TIMEOUT=120

# -----------------------------------------------------------------------------
# Phase 4: Trading Strategy
# -----------------------------------------------------------------------------
# MAX_POSITION_SIZE_KRW=1000000
# MAX_PORTFOLIO_POSITIONS=5
# STOP_LOSS_PERCENT=3.0
# TAKE_PROFIT_PERCENT=5.0
# DAILY_LOSS_LIMIT_KRW=500000

# Phase 4: Risk Management + Position Sizing
# RISK_CHECK_ENABLED=true
# RISK_PER_TRADE_PCT=2.0              # 1건당 리스크 비율 (총 자산 대비 %)
# MAX_POSITION_PCT=10.0               # 단일 종목 최대 비중 (%)
# SECTOR_CONCENTRATION_PCT=30.0       # 섹터 최대 집중도 (%)
# MAX_DRAWDOWN_PCT=10.0               # 최대 허용 낙폭 (%)
# DAILY_LOSS_LIMIT_PCT=3.0            # 일일 최대 손실률 (%)
# CORRELATION_THRESHOLD=0.7           # 상관계수 임계치 (0~1)
# MAX_DAILY_TRADES=5                  # 일일 최대 거래 횟수

# -----------------------------------------------------------------------------
# Phase 5: 알림 (Telegram)
# -----------------------------------------------------------------------------
# HUMAN_APPROVAL_REQUIRED=true
# HUMAN_APPROVAL_TIMEOUT_SEC=300
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Phase 5: Web Verification + Auto-Execute (defaults in config.py)
# WEB_VERIFY_ENABLED=true                    # LLM Web Search 최종 검증 활성화
# WEB_VERIFY_SKIP_ON_STOP_LOSS=true          # 손절 시 Web Search 생략
# AUTO_EXECUTE_MAX_PORTFOLIO_PCT=5.0          # 자동 실행 임계치 (포트폴리오 비중 %)
# USE_MOCK_BROKER=false                      # true면 InMemoryBroker 사용 (테스트용)

# Phase 5: KIS 체결통보 WebSocket (H0STCNI0 실전 / H0STCNI9 모의)
# EXECUTION_STREAM_ENABLED=true              # false면 WS 비활성, reconciler만 사용
# KIS_WS_URL_LIVE=ws://ops.koreainvestment.com:21000
# KIS_WS_URL_PAPER=ws://ops.koreainvestment.com:31000
# KIS_WS_APPROVAL_URL_LIVE=https://openapi.koreainvestment.com:9443/oauth2/Approval
# KIS_WS_APPROVAL_URL_PAPER=https://openapivts.koreainvestment.com:29443/oauth2/Approval
# ORDER_FILL_TIMEOUT_SEC=1800                # WS 체결 대기 타임아웃(초). 초과 시 reconciler 대기
# WS_RECONNECT_BACKOFF_MAX_SEC=60            # WS 재연결 백오프 상한

# -----------------------------------------------------------------------------
# Phase 6: Scheduler + Report + Monitoring
# -----------------------------------------------------------------------------
# SCHEDULER_ENABLED=true
# PRE_MARKET_ANALYSIS_TIME=08:30
# TRADING_SCAN_INTERVAL_MIN=30

# Phase 6: 작업 스케줄 (defaults in config.py)
# MARKET_DATA_COLLECTION_TIME=15:40      # 장 마감 후 시세 수집
# SWING_ANALYSIS_TIME=01:00              # 스윙 분석+매수 (UTC, KST 10:00 장중)
# SWING_ANALYSIS_DAYS=mon,tue,wed,thu,fri  # 스윙 분석 실행 요일 (평일만)
# POSITION_ANALYSIS_DAYS=wed,sat         # 포지션 분석 요일
# POSITION_ANALYSIS_TIME=01:30           # 포지션 분석+매수 (UTC, KST 10:30 장중)
# STOP_LOSS_CHECK_INTERVAL_MIN=5         # 손절 체크 간격 (분)
# DAILY_REPORT_TIME=20:00                # 일간 리포트
# WEEKLY_REPORT_DAY=sat                  # 주간 리포트 요일
# WEEKLY_REPORT_TIME=10:00               # 주간 리포트 시각
# MONTHLY_REPORT_DAY=1                   # 월간 리포트 날짜 (매월 N일)
# MONTHLY_REPORT_TIME=10:00              # 월간 리포트 시각
# TOKEN_REFRESH_TIME=06:00               # KIS 토큰 갱신
# LLM_COST_REPORT_DAY=mon               # LLM 비용 리포트 요일
# LLM_COST_REPORT_TIME=09:00            # LLM 비용 리포트 시각

# Phase 6: 모니터링 임계치 (defaults in config.py)
# MONITOR_STOP_LOSS_PROXIMITY_PCT=2.0    # 손절 근접 경고 (%)
# MONITOR_SECTOR_WEIGHT_WARN_PCT=25.0    # 섹터 비중 경고 (%)
# MONITOR_LLM_BUDGET_WARN_PCT=80.0       # LLM 예산 경고 (%)

# Phase 6: 성과 계산
# RISK_FREE_RATE_PCT=3.5                 # 무위험수익률 (Sharpe 계산용)
# INITIAL_CAPITAL=10000000               # 초기 자본금 (원)

# -----------------------------------------------------------------------------
# Phase 7: Backtesting
# -----------------------------------------------------------------------------
# ALERT_TELEGRAM_ENABLED=true
# ALERT_EMAIL_TO=
# BACKTEST_DEFAULT_INITIAL_CAPITAL=10000000   # 초기 자본 (원, 기본 1000만원)
# BACKTEST_SLIPPAGE_BPS=10                    # 슬리피지 (bps, 기본 10 = 0.1%)
# BACKTEST_MAX_WORKERS=4                      # 병렬 백테스트 최대 워커 수

# -----------------------------------------------------------------------------
# Phase 8: Multi-Account
# -----------------------------------------------------------------------------
# ACCOUNT_ENCRYPTION_KEY=          # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# -----------------------------------------------------------------------------
# Phase 9: Backoffice + Telegram Commands
# -----------------------------------------------------------------------------
# ADMIN_PASSWORD=                  # 백오피스 로그인 비밀번호
# SESSION_SECRET_KEY=              # 세션 쿠키 서명 키

# -----------------------------------------------------------------------------
# Phase 10: Production (단일 EC2 + Docker Compose)
# -----------------------------------------------------------------------------
# POSTGRES_PASSWORD=                # docker-compose.prod.yml이 사용하는 PostgreSQL 비밀번호
# SENTRY_DSN=                       # (선택) 에러 모니터링
